# Copy this file to .env.cloudflare.local (git-ignored) and fill in real
# values. See CLOUDFLARE.md for how to create the API token and what each
# variable is for. Nothing here is read by `npm run dev`; it only matters
# for `npm run deploy:cloudflare`.

# A scoped API token: Account -> Workers Scripts -> Edit, Account ->
# Account Settings -> Read, restricted to the one account hosting the site.
CLOUDFLARE_API_TOKEN=your_scoped_token
CLOUDFLARE_ACCOUNT_ID=your_account_id

# Alternative to the token above: a Global API Key plus the account email.
# Global keys have full account access, so prefer the scoped token instead.
# CLOUDFLARE_API_KEY=your_global_api_key
# CLOUDFLARE_EMAIL=you@example.com

# Where the contact form's messages are delivered. Optional: leave unset to
# build and deploy with the contact form disabled.
CONTACT_TO=you@example.com
