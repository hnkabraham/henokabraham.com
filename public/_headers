/*
  X-Content-Type-Options: nosniff
# The credits pages are documents served straight from the assets, so they
# carry the transport and embedding policy worker.ts gives the page.
/credits/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Every script and stylesheet here is named by its content hash (or sits in a
# build-ID folder), so a repeat visit need not revalidate any of them.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
# Images and video keep their names when they change, so
# they can't be immutable; a day's freshness with a week of revalidating in
# the background saves a repeat visit some thirty conditional requests.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
